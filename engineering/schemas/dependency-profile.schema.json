{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gustavaopere/minecraft-mod-factory/engineering/schemas/dependency-profile.schema.json",
  "title": "Dependency Profile",
  "type": "object",
  "required": ["schema_version", "provider", "capabilities", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "provider": {
      "type": "object",
      "required": ["mod_id", "physical_version", "source_repository", "source_ref", "audited_at", "loader", "minecraft_version", "license", "confidence", "state"],
      "additionalProperties": false,
      "properties": {
        "mod_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "physical_version": {"type": "string", "minLength": 1},
        "source_repository": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "audited_at": {"type": "string", "minLength": 1},
        "loader": {"type": "string", "const": "neoforge"},
        "minecraft_version": {"type": "string", "const": "1.21.1"},
        "license": {"type": "string", "minLength": 1},
        "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW", "UNRESOLVED"]},
        "state": {"type": "string", "enum": ["CONFIRMED", "IMPLEMENTED", "MERGED", "PASS", "PENDING", "UNRESOLVED", "UNAVAILABLE", "DEFERRED", "REFERENCE_ONLY", "INCOMPATIBLE", "BLOCKED", "SUPERSEDED"]}
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "state", "evidence"],
        "additionalProperties": false,
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["CONFIRMED", "IMPLEMENTED", "MERGED", "PASS", "PENDING", "UNRESOLVED", "UNAVAILABLE", "DEFERRED", "REFERENCE_ONLY", "INCOMPATIBLE", "BLOCKED", "SUPERSEDED"]},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["sources", "notes"],
      "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
