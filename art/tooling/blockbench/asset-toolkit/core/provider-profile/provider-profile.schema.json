{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gustavaopere.dev/schemas/rpg-asset-provider-profile.schema.json",
  "title": "RPG Asset Provider Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "authority", "capabilities", "requiredExtensions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "family": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "assetKind": {"type": "string", "minLength": 1},
    "requiredProvider": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["modId", "exactVersions"],
          "properties": {
            "modId": {"type": "string", "minLength": 1},
            "exactVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "requiredExtensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
