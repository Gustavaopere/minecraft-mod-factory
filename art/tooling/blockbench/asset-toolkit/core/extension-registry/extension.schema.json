{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gustavaopere.dev/schemas/blockbench-extension.schema.json",
  "title": "Blockbench Extension Capability Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["pluginId", "pluginVersion", "classification", "mcpPolicy"],
  "properties": {
    "pluginId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "pluginVersion": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["REQUIRED_PROFILE", "PREFERRED", "OPTIONAL", "EXPERIMENTAL", "DEV_ONLY", "HUMAN_ONLY", "AUDIT_REQUIRED", "BLOCKED_LEGACY", "INCOMPATIBLE_EDITOR", "LOADER_MISMATCH", "PROVIDER_ABSENT", "NOT_RUNTIME_AUTHORITY", "DISABLED_BY_DEFAULT"]
    },
    "mcpPolicy": {"enum": ["ALLOWLIST", "NEVER"]},
    "providerFamily": {"type": "string", "minLength": 1},
    "blockbenchCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minInclusive": {"type": "string", "minLength": 1},
        "maxExclusive": {"type": "string", "minLength": 1},
        "auditedExact": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
