{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Gustavaopere/minecraft-mod-factory/construction/schemas/build-spec.schema.json",
  "title": "Construction BuildSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "target", "geometry", "palette", "outputs"],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "seed"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "description": {"type": "string"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraft_version", "loader"],
      "properties": {
        "minecraft_version": {"const": "1.21.1"},
        "loader": {"enum": ["neoforge", "none"]},
        "modpack_snapshot": {"type": "string", "minLength": 1}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_size"],
      "properties": {
        "max_size": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {
            "x": {"type": "integer", "minimum": 1},
            "y": {"type": "integer", "minimum": 1},
            "z": {"type": "integer", "minimum": 1}
          }
        },
        "terrain_policy": {"enum": ["flat", "preserve", "adapt", "unspecified"]},
        "architectural_brief": {"type": "string"},
        "required_spaces": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_modded"],
      "properties": {
        "allow_modded": {"type": "boolean"},
        "allowed_namespaces": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
          "uniqueItems": true
        },
        "forbidden_blocks": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"},
          "uniqueItems": true
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_walkability": {"type": "boolean"},
        "require_complete_interior": {"type": "boolean"},
        "require_determinism": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["sponge_v3", "litematic", "structure_nbt"]}
        }
      }
    }
  }
}
