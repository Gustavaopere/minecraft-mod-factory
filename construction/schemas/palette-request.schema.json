{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-mod-factory.local/schemas/palette-request.schema.json",
  "title": "Minecraft Mod Factory Construction C5 Palette Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "required_terms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_./-]+$"
            }
          },
          "excluded_terms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_./-]+$"
            }
          },
          "preferred_block_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            }
          },
          "preferred_namespaces": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_.-]+$"
            }
          },
          "allowed_safety": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "ordinary",
                "block_entity"
              ]
            }
          },
          "required_state_properties": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9_]+$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "required_terms"
            ],
            "properties": {
              "required_terms": {
                "minItems": 1
              }
            }
          },
          {
            "required": [
              "preferred_block_ids"
            ],
            "properties": {
              "preferred_block_ids": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  }
}
