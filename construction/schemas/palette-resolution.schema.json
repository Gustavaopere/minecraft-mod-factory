{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-mod-factory.local/schemas/palette-resolution.schema.json",
  "title": "Minecraft Mod Factory Construction C5 Palette Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_fingerprint",
    "build_spec_sha256",
    "request_sha256",
    "roles"
  ],
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "properties"
      ],
      "properties": {
        "block": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "namespace",
        "source_mod",
        "safety",
        "state_candidates",
        "selected_state"
      ],
      "properties": {
        "block": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "source_mod": {
          "type": "string",
          "minLength": 1
        },
        "safety": {
          "enum": [
            "ordinary",
            "block_entity"
          ]
        },
        "state_candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "selected_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/state"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "registry_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_spec_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "selected",
          "alternatives"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "selected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "block",
              "namespace",
              "source_mod",
              "safety",
              "state_candidates",
              "selected_state"
            ],
            "properties": {
              "block": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+$"
              },
              "source_mod": {
                "type": "string",
                "minLength": 1
              },
              "safety": {
                "enum": [
                  "ordinary",
                  "block_entity"
                ]
              },
              "state_candidates": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/state"
                }
              },
              "selected_state": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/state"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "alternatives": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/candidate"
            }
          }
        }
      }
    }
  }
}
